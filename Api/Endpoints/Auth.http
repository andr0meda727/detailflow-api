# Run with the "dev" environment. projectUrl and anonKey come from http-client.env.json; your login
# (ownerEmail, ownerPassword, studio_id, ...) from http-client.private.env.json, which git ignores.

### Logging

POST {{projectUrl}}/auth/v1/token?grant_type=password
apikey: {{anonKey}}
Content-Type: application/json

{
  "email": "{{ownerEmail}}",
  "password": "{{ownerPassword}}"
}

> {%
    client.global.set("auth_token", response.body.access_token);
%}

### Sign up

POST {{projectUrl}}/auth/v1/signup
apikey: {{anonKey}}
Content-Type: application/json

{
  "email": "{{ownerEmail}}",
  "password": "{{ownerPassword}}",
  "data": {
    "first_name": "Kuba",
    "last_name": "W"
  }
}

### Zaproszenie pracownika przez Właściciela (Twoje API)
POST {{Api_HostAddress}}/api/users/invite
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "email": "{{employeeEmail}}",
  "role": 2
}